+# test_scaling.py
+
+import numpy as np
+from scaling import wavelet_variability_model
+
+def test_wavelet_variability_model():
+    """
+    Test the wavelet_variability_model function.
+    """
+    irradiance = np.array([1, 2, 3, 4, 5])
+    smoothed_irradiance = wavelet_variability_model(irradiance)
+    assert np.array_equal(smoothed_irradiance, irradiance), "Test failed!"
+
+if __name__ == "__main__":
+    test_wavelet_variability_model()
